  "plan": {
    "summary": "面向2026级新生的室内迎新晚会，以“新程启航”为主线，用节目、互动和社团展示帮助新生快速融入校园。整场控制在120分钟，预算1990元，重点保障音响、节目衔接和现场安全。",
    "background": "新生入学后对校园生活和社团缺乏了解，迎新晚会是建立归属感、展示校园文化的重要节点。活动安排在开学一个月后，既给节目排练留出时间，也避免与军训、期中考试冲突。",
    "objectives": [
      "帮助至少90名新生到场参与，提升对学校的归属感",
      "展示6～8个社团的风采，为后续招新引流",
      "形成一套可复用的迎新晚会流程和分工模板"
    ],
    "highlights": [
      "以“车票”为视觉主线，入场时领取“新程车票”参与抽奖",
      "节目之间穿插社团快闪，减少换场冷场",
      "设置新生心愿墙，活动结束后持续展示一周"
    ],
    "success_criteria": [
      "实际到场人数不低于90人",
      "整场流程偏差不超过10分钟",
      "无安全事故和重大设备故障",
      "预算执行率不超过100%"
    ],
