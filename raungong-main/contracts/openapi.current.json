  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "user"
        ],
        "title": "AuthResponse"
      },
      "DuplicatePlanRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "title": "DuplicatePlanRequest"
      },
      "GenerateAccepted": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "plan_id": {
            "type": "string",
            "title": "Plan Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "queued"
          },
          "reused": {
            "type": "boolean",
            "title": "Reused",
            "default": false
          },
          "estimated_seconds": {
            "type": "integer",
            "title": "Estimated Seconds",
            "default": 3
          },
          "poll_after_ms": {
            "type": "integer",
            "title": "Poll After Ms",
            "default": 1000
          },
          "poll_url": {
            "type": "string",
            "title": "Poll Url"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "plan_id",
          "poll_url"
        ],
        "title": "GenerateAccepted"
      },
      "GeneratePlanRequest": {
        "properties": {
          "theme": {
            "type": "string",
            "maxLength": 60,
            "minLength": 2,
            "title": "Theme"
          },
          "activity_type": {
            "type": "string",
            "maxLength": 32,
            "minLength": 2,
            "title": "Activity Type"
          },
          "participants": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 10.0,
            "title": "Participants"
          },
          "budget_yuan": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Budget Yuan"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 480.0,
            "minimum": 30.0,
            "title": "Duration Minutes",
            "default": 120
          },
          "location": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Location"
          },
          "target_audience": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Audience"
          },
          "goals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Goals"
          },
          "constraints": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Constraints"
          },
          "tone": {
            "type": "string",
            "title": "Tone",
            "default": "lively"
          },
          "extra_notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Extra Notes"
          }
        },
        "type": "object",
        "required": [
          "theme",
          "activity_type",
          "participants",
          "budget_yuan",
          "starts_at",
          "location"
        ],
        "title": "GeneratePlanRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RegisterRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Password"
          },
          "display_name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "display_name"
        ],
        "title": "RegisterRequest"
      },
      "SectionUpdateRequest": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "data": {
            "type": "object",
            "title": "Data"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "version",
          "data"
        ],
        "title": "SectionUpdateRequest"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "created_at"
        ],
        "title": "UserOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
