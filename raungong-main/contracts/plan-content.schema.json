{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activity-mind.local/schemas/plan-content.schema.json",
  "title": "活动智囊结构化活动包",
  "description": "智能体生成、后端校验并持久化的活动执行包。金额单位为人民币元，时间为带时区的 ISO 8601。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "plan",
    "materials",
    "tasks",
    "promotion",
    "risks",
    "review",
    "assumptions",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "materials": {
      "$ref": "#/$defs/materials"
    },
    "tasks": {
      "$ref": "#/$defs/tasks"
    },
    "promotion": {
      "$ref": "#/$defs/promotion"
    },
    "risks": {
      "$ref": "#/$defs/risks"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "assumptions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "$defs": {
    "money": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "multipleOf": 0.01
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "theme",
        "activity_type",
        "activity_type_label",
        "participants",
        "budget_yuan",
        "starts_at",
        "duration_minutes",
        "location",
        "generated_at",
        "agent",
        "degraded"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "theme": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "activity_type": {
          "type": "string",
          "enum": [
            "welcome_party",
            "club_recruitment",
            "team_building",
            "lecture",
            "sports",
            "arts",
            "volunteer",
            "competition",
            "other"
          ]
        },
        "activity_type_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "participants": {
          "type": "integer",
          "minimum": 10,
          "maximum": 2000
        },
        "budget_yuan": {
          "$ref": "#/$defs/money"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 30,
          "maximum": 480
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "prompt_version"],
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["dify", "coze", "mock", "fallback"]
            },
            "prompt_version": {
              "type": "string",
              "maxLength": 32
            }
          }
        },
        "degraded": {
          "type": "boolean"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "background",
        "objectives",
        "highlights",
        "success_criteria",
        "phases",
        "rundown",
        "budget"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "background": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "phases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "rundown": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/rundownItem"
          }
        },
        "budget": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "start_date",
        "end_date",
        "goal",
        "key_actions",
        "owner",
        "deliverables"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "goal": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "key_actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "rundownItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "start_time",
        "end_time",
        "duration_minutes",
        "segment",
        "content",
        "owner",
        "location",
        "notes"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "start_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "segment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "requested_yuan",
        "items_total_yuan",
        "contingency_yuan",
        "planned_yuan",
        "items",
        "funding_sources"
      ],
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "requested_yuan": {
          "$ref": "#/$defs/money"
        },
        "items_total_yuan": {
          "$ref": "#/$defs/money"
        },
        "contingency_yuan": {
          "$ref": "#/$defs/money"
        },
        "planned_yuan": {
          "$ref": "#/$defs/money"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/budgetItem"
          }
        },
        "funding_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "amount_yuan"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 50
              },
              "amount_yuan": {
                "$ref": "#/$defs/money"
              }
            }
          }
        }
      }
    },
    "budgetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "name",
        "unit",
        "quantity",
        "unit_price_yuan",
        "amount_yuan",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^B[0-9]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "场地布置",
            "设备租赁",
            "节目道具",
            "餐饮",
            "奖品",
            "宣传",
            "交通",
            "其他"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "unit_price_yuan": {
          "$ref": "#/$defs/money"
        },
        "amount_yuan": {
          "$ref": "#/$defs/money"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "summary"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/materialItem"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_items", "total_quantity", "estimated_cost_yuan"],
          "properties": {
            "total_items": {
              "type": "integer",
              "minimum": 1
            },
            "total_quantity": {
              "type": "integer",
              "minimum": 1
            },
            "estimated_cost_yuan": {
              "$ref": "#/$defs/money"
            }
          }
        }
      }
    },
    "materialItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "name",
        "spec",
        "unit",
        "quantity",
        "unit_price_yuan",
        "subtotal_yuan",
        "purchase_channel",
        "owner",
        "needed_by",
        "status",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]+$"
        },
        "category": {
          "type": "string",
          "enum": [
            "场地布置",
            "设备",
            "道具",
            "餐饮",
            "奖品",
            "宣传",
            "办公",
            "其他"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "spec": {
          "type": "string",
          "maxLength": 120
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "unit_price_yuan": {
          "$ref": "#/$defs/money"
        },
        "subtotal_yuan": {
          "$ref": "#/$defs/money"
        },
        "purchase_channel": {
          "type": "string",
          "enum": ["网购", "线下", "租赁", "借用", "学校提供", "其他"]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "needed_by": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "purchased", "borrowed", "ready"]
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "summary"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/taskItem"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "by_priority"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "by_priority": {
              "type": "object",
              "additionalProperties": false,
              "required": ["high", "medium", "low"],
              "properties": {
                "high": {
                  "type": "integer",
                  "minimum": 0
                },
                "medium": {
                  "type": "integer",
                  "minimum": 0
                },
                "low": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "taskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "name",
        "role",
        "owner",
        "collaborators",
        "start_at",
        "due_at",
        "priority",
        "depends_on",
        "acceptance",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "phase": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "collaborators": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          }
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "depends_on": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]+$"
          }
        },
        "acceptance": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slogan", "key_messages", "copy", "channels", "poster_copy"],
      "properties": {
        "slogan": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50
        },
        "key_messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "body", "hashtags", "call_to_action"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            },
            "body": {
              "type": "string",
              "minLength": 10,
              "maxLength": 1000
            },
            "hashtags": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              }
            },
            "call_to_action": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "content", "publish_at", "owner"],
            "properties": {
              "channel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "content": {
                "type": "string",
                "minLength": 2,
                "maxLength": 500
              },
              "publish_at": {
                "type": "string",
                "format": "date-time"
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              }
            }
          }
        },
        "poster_copy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline", "subheadline", "footer"],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30
            },
            "subheadline": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "footer": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          }
        }
      }
    },
    "risks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "summary"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 6,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/riskItem"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "high", "medium", "low"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 6
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "riskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "description",
        "level",
        "probability",
        "impact",
        "trigger",
        "mitigation",
        "contingency",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R[0-9]+$"
        },
        "category": {
          "type": "string",
          "enum": ["安全", "设备", "人员", "预算", "天气", "场地", "舆情", "宣传", "其他"]
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "probability": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "impact": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "trigger": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "mitigation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "contingency": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kpis", "retro_questions", "checklist", "template_markdown"],
      "properties": {
        "kpis": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "target", "method"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 50
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 50
              },
              "method": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100
              }
            }
          }
        },
        "retro_questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 15,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          }
        },
        "checklist": {
          "type": "array",
          "minItems": 3,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          }
        },
        "template_markdown": {
          "type": "string",
          "minLength": 20,
          "maxLength": 8000
        }
      }
    }
  }
}
